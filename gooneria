        lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.TextTruncate=Enum.TextTruncate.AtEnd; lbl.ZIndex=33
        btn.MouseEnter:Connect(function() btn.BackgroundColor3=BG3 end)
        btn.MouseLeave:Connect(function() btn.BackgroundColor3=BG end)
        btn.MouseButton1Click:Connect(function()
            for _,b in ipairs(LeftPane:GetChildren()) do
                if b:IsA("TextButton") then b.BackgroundColor3=BG end
            end
            btn.BackgroundColor3=Color3.fromRGB(18,35,75)
            showProps(inst)
        end)
    end

    local svcNames={"Workspace","Players","Lighting","ReplicatedStorage","StarterGui","ServerScriptService","ReplicatedFirst"}
    for _,sn in ipairs(svcNames) do
        local svc = pcall(function() return game:GetService(sn) end) and game:FindService(sn)
        if svc then
