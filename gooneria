-- ESP
local function addESP(player)
    if player == LP then return end
    local function apply()
        local char = player.Character; if not char then return end
        if espHL[player] then espHL[player]:Destroy() end
        local hl = Instance.new("Highlight", char)
        hl.FillColor = Color3.fromRGB(30,80,220)
        hl.OutlineColor = Color3.fromRGB(130,175,255)
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        espHL[player] = hl
    end
    apply()
    player.CharacterAdded:Connect(function()
        task.wait(0.1); if flags["ESP"] then apply() end
    end)
end
local function removeESP(player)
    if espHL[player] then espHL[player]:Destroy(); espHL[player] = nil end
end
local function enableESP()
    for _, p in ipairs(Players:GetPlayers()) do addESP(p) end
    Players.PlayerAdded:Connect(function(p) if flags["ESP"] then addESP(p) end end)
    Players.PlayerRemoving:Connect(removeESP)
end
local function disableESP()
    for _, p in ipairs(Players:GetPlayers()) do removeESP(p) end
end

