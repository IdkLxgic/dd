-- ================================================================
--  REMOTE SPY (Studio + Live)
-- ================================================================
local rspyScroll = nil
local rspyActive = false
local hookedRemotes = {}
local MAX_RSPY = 200

local function rspyEntry(text, color)
    if not rspyScroll then return end
    local kids = {}
    for _,c in ipairs(rspyScroll:GetChildren()) do
        if c:IsA("Frame") then table.insert(kids,c) end
    end
    if #kids >= MAX_RSPY then
        for i=1,10 do if kids[i] then kids[i]:Destroy() end end
    end
    local row = Instance.new("Frame", rspyScroll)
    row.Size = UDim2.new(1,0,0,16); row.BackgroundTransparency=1; row.BorderSizePixel=0; row.ZIndex=4
    local t = Instance.new("TextLabel", row)
    t.Size=UDim2.new(1,0,1,0); t.BackgroundTransparency=1
    t.Text=text; t.TextColor3=color or TEXT2; t.TextSize=9; t.Font=Enum.Font.Code
    t.TextXAlignment=Enum.TextXAlignment.Left; t.TextTruncate=Enum.TextTruncate.AtEnd; t.ZIndex=5
    task.defer(function()
        if rspyScroll then
            rspyScroll.CanvasPosition = Vector2.new(0, rspyScroll.AbsoluteCanvasSize.Y)
        end
    end)
end

local function fmtArgs(...)
    local parts={}
    for _,a in ipairs({...}) do
        local t=typeof(a)
        if t=="string" then table.insert(parts,'"'..a:sub(1,20)..'"')
        elseif t=="number" then table.insert(parts,tostring(a))
        elseif t=="boolean" then table.insert(parts,tostring(a))
        elseif t=="Instance" then table.insert(parts,a.ClassName.."."..a.Name)
        elseif t=="Vector3" then table.insert(parts,("V3(%.1f,%.1f,%.1f)"):format(a.X,a.Y,a.Z))
        elseif t=="Vector2" then table.insert(parts,("V2(%.1f,%.1f)"):format(a.X,a.Y))
        else table.insert(parts,"["..t.."]") end
    end
    return table.concat(parts,", ")
end

local function hookRemote(r)
    if hookedRemotes[r] then return end
    hookedRemotes[r] = true
    if r:IsA("RemoteEvent") then
        r.OnClientEvent:Connect(function(...)
            if not rspyActive then return end
            rspyEntry("[OnClientEvent] "..r.Name.."  "..fmtArgs(...), ACCENT)
        end)
    elseif r:IsA("RemoteFunction") then
        local old = r.OnClientInvoke
        r.OnClientInvoke = function(...)
            if rspyActive then
                rspyEntry("[OnClientInvoke] "..r.Name.."  "..fmtArgs(...), Color3.fromRGB(140,200,255))
            end
            if old then return old(...) end
        end
    end
end

local function startRSpy()
    rspyActive = true
    for _,d in ipairs(game:GetDescendants()) do
        if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then hookRemote(d) end
    end
    game.DescendantAdded:Connect(function(d)
        task.wait()
        if rspyActive and (d:IsA("RemoteEvent") or d:IsA("RemoteFunction")) then hookRemote(d) end
    end)
    -- Executor namecall hook (non-Studio)
    pcall(function()
        if not IS_STUDIO and getrawmetatable and setreadonly and newcclosure then
            local mt = getrawmetatable(game); local orig = mt.__namecall
            setreadonly(mt, false)
            mt.__namecall = newcclosure(function(self,...)
                local method = getnamecallmethod()
                if rspyActive and (method=="FireServer" or method=="InvokeServer") then
                    rspyEntry("[FireServer] "..tostring(self.Name).."  "..fmtArgs(...), ORANGE)
                end
                return orig(self,...)
            end)
            setreadonly(mt, true)
            rspyEntry("[RSpy] Namecall hook active", GREEN)
        else
            rspyEntry("[RSpy] Studio: OnClientEvent scanning active", ORANGE)
        end
    end)
    rspyEntry("[RSpy] Started", GREEN)
end
local function stopRSpy()
    rspyActive = false
    rspyEntry("[RSpy] Stopped", RED)
end

