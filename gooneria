local CMDS = {}
local HELP_LIST = {}

local function reg(names, fn, help)
    for _, n in ipairs(names) do CMDS[n:lower()] = fn end
    table.insert(HELP_LIST, {name=names[1], aliases=names, help=help})
end

local function runCommand(raw)
    raw = raw:match("^%s*(.-)%s*$")
    if raw=="" then return end
    local cmd = raw:match("^/") and raw:sub(2) or raw
    local parts={}; for w in cmd:gmatch("%S+") do table.insert(parts,w) end
    local name=parts[1] and parts[1]:lower() or ""
    table.remove(parts,1)
    local fn=CMDS[name]
    if fn then
        local ok,err=pcall(fn, parts)
        if not ok then notify("Error",tostring(err):sub(1,60),RED) end
    else
        notify("Unknown","/"..name.." - type /help",RED)
    end
end

