local TABS = {
    {name="Movement", page=P_Move},
    {name="Player",   page=P_Player},
    {name="Visuals",  page=P_Visual},
    {name="World",    page=P_World},
    {name="Players",  page=P_Players},
    {name="Server",   page=P_Server},
    {name="RSpy",     page=P_RSpy},
}

local activePage, activeBtn = nil, nil

local function switchTab(tab, btn)
    if activePage then activePage.Visible = false end
    if activeBtn and activeBtn ~= btn then
        TweenService:Create(activeBtn,TweenInfo.new(0.1),{BackgroundColor3=BG2}):Play()
        for _,c in ipairs(activeBtn:GetChildren()) do
            if c:IsA("TextLabel") then c.TextColor3=TEXT2 end
        end
    end
    tab.page.Visible = true
    btn.BackgroundColor3 = BG3
    for _,c in ipairs(btn:GetChildren()) do
        if c:IsA("TextLabel") then
            TweenService:Create(c,TweenInfo.new(0.1),{TextColor3=TEXT}):Play()
        end
    end
    -- Blue left accent bar
    for _,child in ipairs(btn:GetChildren()) do
        if child.Name=="AccentBar" then child:Destroy() end
    end
    local bar = Instance.new("Frame", btn)
    bar.Name = "AccentBar"
    bar.Size = UDim2.new(0,2,1,0); bar.Position = UDim2.new(0,0,0,0)
    bar.BackgroundColor3 = ACCENT; bar.BorderSizePixel = 0; bar.ZIndex = 5
    activePage = tab.page; activeBtn = btn
end

for i, tab in ipairs(TABS) do
    local btn = Instance.new("TextButton", Sidebar)
    btn.Name = tab.name
    btn.Size = UDim2.new(1,0,0,30)
    btn.BackgroundColor3 = BG2; btn.BorderSizePixel = 0
    btn.Text = ""; btn.ZIndex = 4; btn.LayoutOrder = i
    local lbl = Instance.new("TextLabel", btn)
    lbl.Size = UDim2.new(1,-8,1,0); lbl.Position = UDim2.new(0,8,0,0)
    lbl.BackgroundTransparency = 1; lbl.Text = tab.name
    lbl.TextColor3 = TEXT2; lbl.TextSize = 11; lbl.Font = Enum.Font.GothamSemibold
    lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.ZIndex = 5
    -- Bottom divider
    local div = Instance.new("Frame", btn)
    div.Size = UDim2.new(1,0,0,1); div.Position = UDim2.new(0,0,1,-1)
    div.BackgroundColor3 = BORDER; div.BorderSizePixel = 0; div.ZIndex = 5

    local cTab, cBtn = tab, btn
    btn.MouseButton1Click:Connect(function() switchTab(cTab, cBtn) end)
    btn.MouseEnter:Connect(function()
        if cBtn ~= activeBtn then
            TweenService:Create(cBtn,TweenInfo.new(0.08),{BackgroundColor3=BG3}):Play()
        end
    end)
    btn.MouseLeave:Connect(function()
        if cBtn ~= activeBtn then
            TweenService:Create(cBtn,TweenInfo.new(0.08),{BackgroundColor3=BG2}):Play()
        end
    end)
end

-- Default to first tab
local firstBtn = Sidebar:FindFirstChild("Movement")
if firstBtn then switchTab(TABS[1], firstBtn) end

