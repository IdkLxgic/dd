    local function showProps(inst)
        for _,c in ipairs(RightPane:GetChildren()) do
            if c:IsA("Frame") then c:Destroy() end
        end
        if not inst then return end
        local idx=0
        local function pr(k,v) idx=idx+1; propRow(k,v,idx) end
        pr("Name", inst.Name); pr("ClassName", inst.ClassName)
        pr("Parent", inst.Parent and inst.Parent.Name or "nil")
        pr("FullName", inst:GetFullName())
        pr("Children", #inst:GetChildren())
        pcall(function() pr("Archivable", inst.Archivable) end)
        if inst:IsA("BasePart") then
            pcall(function()
                pr("Position", tostring(inst.Position))
                pr("Size", tostring(inst.Size))
                pr("Anchored", inst.Anchored)
                pr("CanCollide", inst.CanCollide)
                pr("Transparency", inst.Transparency)
                pr("Material", tostring(inst.Material))
                pr("CastShadow", inst.CastShadow)
                pr("Mass", inst:GetMass())
            end)
        elseif inst:IsA("Humanoid") then
            pcall(function()
                pr("Health", inst.Health); pr("MaxHealth", inst.MaxHealth)
                pr("WalkSpeed", inst.WalkSpeed); pr("JumpPower", inst.JumpPower)
                pr("State", tostring(inst:GetState()))
            end)
        elseif inst:IsA("Script") or inst:IsA("LocalScript") then
            pcall(function() pr("Disabled", inst.Disabled) end)
        elseif inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction") then
            pr("Type", inst.ClassName)
        elseif inst:IsA("Model") then
            pcall(function()
                local primary = inst.PrimaryPart
                pr("PrimaryPart", primary and primary.Name or "nil")
            end)
        end
    end

    local nodeIdx = 0
    local function addNode(inst, depth)
        nodeIdx = nodeIdx+1
        local btn = Instance.new("TextButton", LeftPane)
        btn.Size = UDim2.new(1,0,0,18); btn.BackgroundColor3=BG
        btn.BorderSizePixel=0; btn.LayoutOrder=nodeIdx; btn.ZIndex=32; btn.Text=""
        local icons = {Workspace="[W]",Model="[M]",Part="[P]",MeshPart="[P]",
            Script="[S]",LocalScript="[LS]",RemoteEvent="[RE]",RemoteFunction="[RF]",
            Folder="[F]",Tool="[T]",Humanoid="[H]",Accessory="[A]",Animation="[AN]"}
        local icon=""
        for k,v in pairs(icons) do if inst:IsA(k) then icon=v; break end end
        local lbl=Instance.new("TextLabel",btn)
        lbl.Size=UDim2.new(1,0,1,0); lbl.Position=UDim2.new(0,8+depth*10,0,0)
        lbl.BackgroundTransparency=1; lbl.Text=icon.." "..inst.Name
