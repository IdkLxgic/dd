-- toggleSetters table so commands can flip UI toggles by name
local toggleSetters = {}

local function mkToggle(name, desc, parent, default, onChange)
    lo = lo+1
    local state = default or false
    flags[name] = state

    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1,0,0,36); row.BackgroundColor3 = BG2
    row.BorderSizePixel = 0; row.LayoutOrder = lo; row.ZIndex = 3
    Instance.new("UIStroke", row).Color = BORDER

    local nL = Instance.new("TextLabel", row)
    nL.Size = UDim2.new(1,-54,0,20); nL.Position = UDim2.new(0,8,0,4)
    nL.BackgroundTransparency = 1; nL.Text = name; nL.TextColor3 = TEXT
    nL.TextSize = 11; nL.Font = Enum.Font.GothamSemibold
    nL.TextXAlignment = Enum.TextXAlignment.Left; nL.ZIndex = 4

    local dL = Instance.new("TextLabel", row)
    dL.Size = UDim2.new(1,-54,0,13); dL.Position = UDim2.new(0,8,0,21)
    dL.BackgroundTransparency = 1; dL.Text = desc or ""
    dL.TextColor3 = TEXT3; dL.TextSize = 9; dL.Font = Enum.Font.Gotham
    dL.TextXAlignment = Enum.TextXAlignment.Left; dL.ZIndex = 4

    local pill = Instance.new("Frame", row)
    pill.Size = UDim2.new(0,36,0,18); pill.Position = UDim2.new(1,-46,0.5,-9)
    pill.BackgroundColor3 = state and ACCENT or BG3
    pill.BorderSizePixel = 0; pill.ZIndex = 4
    Instance.new("UICorner", pill).CornerRadius = UDim.new(1,0)
    local knob = Instance.new("Frame", pill)
    knob.Size = UDim2.new(0,12,0,12)
    knob.Position = state and UDim2.new(0,21,0.5,-6) or UDim2.new(0,3,0.5,-6)
    knob.BackgroundColor3 = TEXT; knob.BorderSizePixel = 0; knob.ZIndex = 5
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1,0)

    local ti = TweenInfo.new(0.14, Enum.EasingStyle.Quart)
    local function setOn(v)
        state = v; flags[name] = v
        TweenService:Create(pill, ti, {BackgroundColor3 = v and ACCENT or BG3}):Play()
        TweenService:Create(knob, ti, {Position = v and UDim2.new(0,21,0.5,-6) or UDim2.new(0,3,0.5,-6)}):Play()
        TweenService:Create(nL, ti, {TextColor3 = v and ACCENT or TEXT}):Play()
        if onChange then onChange(v) end
    end

    toggleSetters[name] = setOn

    local btn = Instance.new("TextButton", row)
    btn.Size = UDim2.new(1,0,1,0); btn.BackgroundTransparency = 1
    btn.Text = ""; btn.ZIndex = 6
    btn.MouseButton1Click:Connect(function() setOn(not state) end)
    btn.MouseEnter:Connect(function() TweenService:Create(row,TweenInfo.new(0.08),{BackgroundColor3=BG3}):Play() end)
    btn.MouseLeave:Connect(function() TweenService:Create(row,TweenInfo.new(0.08),{BackgroundColor3=BG2}):Play() end)
    return setOn
end

