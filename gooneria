-- FOLLOW
local function startFollow(name)
    local p = findPlayer(name)
    if not p then notify("Follow","Player not found",RED); return end
    stopConn("follow")
    flags["Follow"] = true
    conns.follow = RunService.Heartbeat:Connect(function(dt)
        if not flags["Follow"] then stopConn("follow"); return end
        if not p.Character then return end
        local hrp = getHRP()
        local t = p.Character:FindFirstChild("HumanoidRootPart")
        if not hrp or not t then return end
        local dist = (t.Position - hrp.Position).Magnitude
        if dist > 4 then
            local dir = (t.Position - hrp.Position).Unit
            hrp.CFrame = hrp.CFrame + Vector3.new(dir.X,0,dir.Z)*math.min(dist-3,(vals.Walkspeed or 16))*dt
        end
    end)
    notify("Follow","Following "..p.Name,ACCENT)
end

-- ORBIT
local function startOrbit(name)
    local p = findPlayer(name)
    if not p then notify("Orbit","Player not found",RED); return end
    stopConn("orbit"); flags["Orbit"] = true
    local t2 = 0
    conns.orbit = RunService.Heartbeat:Connect(function(dt)
        if not flags["Orbit"] then stopConn("orbit"); return end
        if not p.Character then return end
        local hrp = getHRP()
        local pt = p.Character:FindFirstChild("HumanoidRootPart")
        if not hrp or not pt then return end
        t2 = t2 + dt*(vals.OrbitSpeed or 2)
        local r = vals.OrbitRadius or 8
        hrp.CFrame = CFrame.new(
            pt.Position + Vector3.new(math.cos(t2)*r, 0, math.sin(t2)*r),
            pt.Position
        )
    end)
    notify("Orbit","Orbiting "..p.Name,ACCENT)
end

