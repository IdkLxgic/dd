    tr.Size = UDim2.new(1,-16,0,4); tr.Position = UDim2.new(0,8,0,30)
    tr.BackgroundColor3 = BG3; tr.BorderSizePixel = 0; tr.ZIndex = 4
    Instance.new("UICorner", tr).CornerRadius = UDim.new(1,0)

    local fill = Instance.new("Frame", tr)
