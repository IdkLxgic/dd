local winVisible = true

local function closeWin()
    winVisible = false
    local cx = Win.Position.X.Offset + WIN_W/2
    local cy = Win.Position.Y.Offset + WIN_H/2
    TweenService:Create(Win, TweenInfo.new(0.16,Enum.EasingStyle.Quart,Enum.EasingDirection.In), {
        Size = UDim2.new(0,0,0,0),
        Position = UDim2.new(Win.Position.X.Scale, cx, Win.Position.Y.Scale, cy),
    }):Play()
    task.delay(0.18, function()
        Win.Visible = false
        Win.Size = UDim2.new(0,WIN_W,0,WIN_H)
    end)
end

local function openWin()
    winVisible = true
    Win.Visible = true
    Win.Size = UDim2.new(0,0,0,0)
    Win.Position = UDim2.new(0.5,0,0.5,0)
    TweenService:Create(Win, TweenInfo.new(0.24,Enum.EasingStyle.Back,Enum.EasingDirection.Out), {
        Size = UDim2.new(0,WIN_W,0,WIN_H),
        Position = UDim2.new(0.5,-WIN_W/2,0.5,-WIN_H/2),
    }):Play()
end

CloseBtn.MouseButton1Click:Connect(closeWin)

UserInputService.InputBegan:Connect(function(inp, gpe)
    if gpe then return end
    if inp.KeyCode == Enum.KeyCode.LeftControl or inp.KeyCode == Enum.KeyCode.RightControl then
        if winVisible then closeWin() else openWin() end
    end
end)

