-- NORMAL FLY (BodyVelocity)
local flyBV, flyBG
local function startNormalFly()
    local hrp = getHRP(); if not hrp then return end
    if flyBV then flyBV:Destroy() end
    if flyBG then flyBG:Destroy() end
    flyBV = Instance.new("BodyVelocity", hrp)
    flyBV.Velocity = Vector3.zero; flyBV.MaxForce = Vector3.new(1e5,1e5,1e5)
    flyBG = Instance.new("BodyGyro", hrp)
    flyBG.MaxTorque = Vector3.new(1e5,1e5,1e5); flyBG.P = 1e4
    stopConn("normalfly")
    conns.normalfly = RunService.Heartbeat:Connect(function()
        if not flags["Normal Fly"] then
            if flyBV then flyBV:Destroy(); flyBV = nil end
            if flyBG then flyBG:Destroy(); flyBG = nil end
            stopConn("normalfly")
            local h = getHum(); if h then h.PlatformStand = false end
            return
        end
        local spd = vals.FlySpeed or 60
        local dir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir=dir+Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir=dir-Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir=dir-Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir=dir+Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir=dir+Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir=dir-Vector3.new(0,1,0) end
        if dir.Magnitude > 0 then dir = dir.Unit end
        flyBV.Velocity = dir*spd; flyBG.CFrame = Camera.CFrame
        local h = getHum(); if h then h.PlatformStand = true end
    end)
end
local function stopNormalFly()
    if flyBV then flyBV:Destroy(); flyBV = nil end
    if flyBG then flyBG:Destroy(); flyBG = nil end
    stopConn("normalfly")
    local h = getHum(); if h then h.PlatformStand = false end
end

-- CFRAME FLY
local function startCFrameFly()
    stopConn("cframefly")
    conns.cframefly = RunService.Heartbeat:Connect(function(dt)
        if not flags["CFrame Fly"] then stopConn("cframefly")
            local h=getHum(); if h then h.PlatformStand=false end; return
        end
        local hrp = getHRP(); if not hrp then return end
        local spd = vals.FlySpeed or 60
        local dir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir=dir+Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir=dir-Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir=dir-Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir=dir+Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir=dir+Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir=dir-Vector3.new(0,1,0) end
        if dir.Magnitude > 0 then hrp.CFrame = hrp.CFrame + dir.Unit*spd*dt end
        local h = getHum(); if h then h.PlatformStand = true end
    end)
end
local function stopCFrameFly()
    stopConn("cframefly")
    local h = getHum(); if h then h.PlatformStand = false end
end

-- NOCLIP FLY
local function startNoclipFly()
    flags["CFrame Fly"] = true
    flags["Noclip"] = true
    startCFrameFly()
end
local function stopNoclipFly()
    flags["CFrame Fly"] = false
    flags["Noclip"] = false
    stopCFrameFly()
end

-- NOCLIP
local noclipOrig = {}
local function disableNoclip()
    for part, v in pairs(noclipOrig) do
        if part and part.Parent then part.CanCollide = v end
    end
    noclipOrig = {}
end

-- INFINITE JUMP
